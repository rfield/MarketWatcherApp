<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="1dp">

    <!-- Top Row: Two Items (e.g., Image and Text) side-by-side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Item 1 (Left) -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1.3"
            android:layout_marginEnd="1dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:textStyle="bold"
                android:text="This is the message title" />
        </androidx.cardview.widget.CardView>

        <!-- Item 2 (Right) -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="0.7"
            android:layout_marginStart="0dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/notification_created_at"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:gravity="end"
                android:text="Jan 1, 2026" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Bottom Row: One Item (e.g., Description Text) across the full width -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="2dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <TextView
            android:id="@+id/notification_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="This is a description text that spans the full width of the item below the two images."
            android:textSize="16sp" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
